rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Deny Catch-All: Default close all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Security guard: Prevent clients from assigning themselves privileged administrator or staff roles
    function hasNoPrivilegedRoleKeys(data) {
      return !('role' in data) && !('isAdmin' in data) && !('isSpecialist' in data) && !('isReviewer' in data);
    }

    // Security guard: Prevent ordinary clients from writing verified/expert review stamps
    function hasNoTamperedVerification(data) {
      return !('expertVerified' in data) && !('verifiedBySpecialist' in data) && !('officialLabStatus' in data) && !('specialistSignature' in data);
    }

    // 1. Farmer Profiles: /profiles/{uid}
    match /profiles/{uid} {
      // Confidentiality: Only the authenticated owner can access their profile
      allow get: if isOwner(uid);
      allow list: if false; // Strictly disallow harvesting or listing other farmers' profiles

      // Create: Only authenticated user matching document UID, validate field lengths & types
      allow create: if isOwner(uid) && isValidId(uid)
        && incoming().uid == request.auth.uid
        && incoming().displayName is string && incoming().displayName.size() > 0 && incoming().displayName.size() <= 100
        && incoming().preferredLanguage in ['en', 'ta']
        && incoming().district is string && incoming().district.size() <= 50
        && hasNoPrivilegedRoleKeys(incoming());

      // Update: Only owner, cannot alter UID or assign administrative privileges
      allow update: if isOwner(uid)
        && incoming().uid == existing().uid
        && incoming().displayName is string && incoming().displayName.size() <= 100
        && incoming().preferredLanguage in ['en', 'ta']
        && hasNoPrivilegedRoleKeys(incoming());

      allow delete: if false; // Protect cadastral accounts from deletion via client SDK

      // Subcollection: Farms: /profiles/{uid}/farms/{farmId}
      match /farms/{farmId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid) && isValidId(farmId)
          && incoming().farmName is string && incoming().farmName.size() > 0 && incoming().farmName.size() <= 100
          && incoming().cropType is string && incoming().cropType.size() <= 50
          && incoming().district is string && incoming().district.size() <= 50;

        allow update: if isOwner(uid)
          && incoming().farmName is string && incoming().farmName.size() > 0 && incoming().farmName.size() <= 100
          && incoming().district is string && incoming().district.size() <= 50;

        allow delete: if isOwner(uid);
      }

      // Subcollection: Scans: /profiles/{uid}/scans/{scanId}
      match /scans/{scanId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid) && isValidId(scanId)
          && incoming().status in ['pending', 'processing', 'completed', 'inconclusive', 'failed']
          && incoming().imagePath is string && incoming().imagePath.size() <= 2000000
          && hasNoTamperedVerification(incoming());

        allow update: if isOwner(uid)
          && incoming().status in ['pending', 'processing', 'completed', 'inconclusive', 'failed']
          && !incoming().diff(existing()).affectedKeys().hasAny(['expertVerified', 'verifiedBySpecialist', 'officialLabStatus', 'specialistSignature']);

        allow delete: if isOwner(uid);
      }
    }

    // 2. Community Field Reports: /fieldReports/{reportId}
    match /fieldReports/{reportId} {
      // Community field reports can be read by all farmers for collective disease surveillance
      allow read: if true;

      allow create: if isSignedIn() && isValidId(reportId)
        && incoming().submittedBy == request.auth.uid
        && incoming().district is string && incoming().district.size() <= 50
        && incoming().suspectedCondition is string && incoming().suspectedCondition.size() <= 150;

      allow update: if isSignedIn()
        && (existing().submittedBy == request.auth.uid)
        && incoming().submittedBy == existing().submittedBy;

      allow delete: if false;
    }

    // 3. District Risk Assessments: /riskAssessments/{assessmentId}
    match /riskAssessments/{assessmentId} {
      // Regional agro-climatic advisories are publicly readable
      allow read: if true;
      allow write: if false; // System / Server privileged write only
    }
  }
}
