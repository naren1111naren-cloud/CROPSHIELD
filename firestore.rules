rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Security guard: Prevent clients from assigning administrative/specialist roles
    function hasNoPrivilegedRoleKeys(data) {
      return !('role' in data) && !('isAdmin' in data) && !('isSpecialist' in data) && !('isReviewer' in data);
    }

    // Security guard: Prevent ordinary clients from writing verified/expert review stamps
    function hasNoTamperedVerification(data) {
      return !('expertVerified' in data) && !('verifiedBySpecialist' in data) && !('officialLabStatus' in data) && !('specialistSignature' in data);
    }

    // 1. Farmer Profiles: /profiles/{uid}
    match /profiles/{uid} {
      // Owner only: Read and modify own profile. Disallow listing all profiles to prevent harvesting.
      allow get: if isOwner(uid);
      allow list: if false;

      // Create: Only authenticated user matching document UID
      allow create: if isOwner(uid)
        && incoming().uid == uid
        && hasNoPrivilegedRoleKeys(incoming());

      // Update: Only owner, cannot alter UID or assign administrative privileges
      allow update: if isOwner(uid)
        && incoming().uid == uid
        && hasNoPrivilegedRoleKeys(incoming());

      // Protect profiles from deletion via client SDK
      allow delete: if false;

      // Subcollection: Farms: /profiles/{uid}/farms/{farmId}
      match /farms/{farmId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid);
        allow delete: if isOwner(uid);
      }

      // Subcollection: Scans: /profiles/{uid}/scans/{scanId}
      match /scans/{scanId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && hasNoTamperedVerification(incoming());
        allow update: if isOwner(uid)
          && !incoming().diff(existing()).affectedKeys().hasAny(['expertVerified', 'verifiedBySpecialist', 'officialLabStatus', 'specialistSignature']);
        allow delete: if isOwner(uid);
      }

      // Subcollection: Enquiries: /profiles/{uid}/enquiries/{enquiryId}
      match /enquiries/{enquiryId} {
        allow read, write: if isOwner(uid);
      }

      // Subcollection: Field Cases: /profiles/{uid}/fieldCases/{caseId}
      match /fieldCases/{caseId} {
        allow read, write: if isOwner(uid);

        match /observations/{observationId} {
          allow read, write: if isOwner(uid);
        }
      }
    }

    // 2. Community Field Reports: /fieldReports/{reportId}
    match /fieldReports/{reportId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().submittedBy == request.auth.uid;
      allow update, delete: if isSignedIn() && (existing().submittedBy == request.auth.uid || request.auth.token.admin == true);
    }

    // 3. Health & Connectivity Verification
    match /test/{testDoc} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
